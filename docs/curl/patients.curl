#!/usr/bin/env bash
# =============================================================================
# Dental Backend — Patients API cURLs (edit endpoints)
# =============================================================================
#
# Base URL:  http://localhost:4000/api/patients
# Auth:      All routes require Authorization: Bearer <token>
#
# Setup:
#   export BASE_URL="http://localhost:4000"
#   export TOKEN="<jwt>"
#   export CLINIC_ID="<clinic-uuid>"
#   export PATIENT_ID="<patient-uuid>"
#
# patientType:       new | existing
# pregnancyStatus:   Not Applicable | Pregnant | Not Pregnant
# dentalAnxiety:     none | mild | moderate | severe
#
# =============================================================================

BASE_URL="${BASE_URL:-http://localhost:4000}"
TOKEN="${TOKEN:-YOUR_JWT_TOKEN}"

AUTH_HEADER="Authorization: Bearer ${TOKEN}"
JSON_HEADER="Content-Type: application/json"
PATIENTS="${BASE_URL}/api/patients"


# =============================================================================
# STEP 0 — LOGIN
# =============================================================================

curl -X POST "${BASE_URL}/api/auth/login" \
  -H "${JSON_HEADER}" \
  -d '{
    "email": "reception@yourvcare.com",
    "password": "YourPassword123"
  }'


# =============================================================================
# 1 — UPDATE PATIENT BASIC DETAILS
# =============================================================================
#
# PATCH /api/patients/:patientId/basic-details
#
# Updates fields on the patients table only.
# At least one field is required.
#
# Request (full example):
# {
#   "name": "Rahul Sharma",
#   "phone": "9876543210",
#   "email": "rahul@example.com",
#   "gender": "Male",
#   "dateOfBirth": "1990-05-15",
#   "address": "Shop 12, Link Road, Andheri West, Mumbai",
#   "emergencyContactName": "Priya Sharma",
#   "emergencyContactPhone": "9123456789",
#   "emergencyContactRelation": "Spouse",
#   "patientType": "existing"
# }
#
# Response (200):
# {
#   "success": true,
#   "message": "Patient basic details updated successfully",
#   "data": {
#     "patient": {
#       "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
#       "patientCode": "PAT000042",
#       "clinicId": "clinic-uuid",
#       "patientType": "existing",
#       "name": "Rahul Sharma",
#       "phone": "9876543210",
#       "email": "rahul@example.com",
#       "gender": "Male",
#       "dateOfBirth": "1990-05-15T00:00:00.000Z",
#       "address": "Shop 12, Link Road, Andheri West, Mumbai",
#       "emergencyContactName": "Priya Sharma",
#       "emergencyContactPhone": "9123456789",
#       "emergencyContactRelation": "Spouse",
#       "isPremiumMember": false,
#       "isBlackListed": false,
#       "blackListedReason": null,
#       "lastVisitAt": null,
#       "isActive": true,
#       "createdAt": "2026-01-10T09:00:00.000Z",
#       "updatedAt": "2026-07-07T11:30:00.000Z"
#     },
#     "medicalProfile": {
#       "id": "medical-profile-uuid",
#       "patientId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
#       "allergies": ["Penicillin"],
#       "currentMedications": ["Metformin"],
#       "chronicConditions": ["Diabetes"],
#       "pregnancyStatus": "Not Applicable",
#       "dentalAnxiety": "mild",
#       "lastDentalVisit": "2025-12-01T00:00:00.000Z",
#       "lastXrayDate": "2025-06-15T00:00:00.000Z",
#       "primaryPhysicianName": "Dr. Patel",
#       "primaryPhysicianPhone": "9988776655",
#       "initialChiefComplaint": "Tooth pain lower left",
#       "createdAt": "2026-01-10T09:00:00.000Z",
#       "updatedAt": "2026-01-10T09:00:00.000Z"
#     },
#     "consents": {
#       "id": "consent-uuid",
#       "patientId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
#       "treatmentConsentSigned": true,
#       "privacyAccepted": true,
#       "acceptedAt": "2026-01-10T09:00:00.000Z",
#       "createdAt": "2026-01-10T09:00:00.000Z",
#       "updatedAt": "2026-01-10T09:00:00.000Z"
#     }
#   }
# }
#
# Error (409):
# { "success": false, "message": "A patient with this phone already exists in this clinic" }

curl -X PATCH "${PATIENTS}/${PATIENT_ID}/basic-details" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "name": "Rahul Sharma",
    "phone": "9876543210",
    "email": "rahul@example.com",
    "gender": "Male",
    "dateOfBirth": "1990-05-15",
    "address": "Shop 12, Link Road, Andheri West, Mumbai",
    "emergencyContactName": "Priya Sharma",
    "emergencyContactPhone": "9123456789",
    "emergencyContactRelation": "Spouse",
    "patientType": "existing"
  }'

# Partial update (only phone and address):
curl -X PATCH "${PATIENTS}/${PATIENT_ID}/basic-details" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "phone": "9900112233",
    "address": "2nd Floor, S V Road, Borivali West"
  }'


# =============================================================================
# 2 — UPDATE PATIENT MEDICAL PROFILE
# =============================================================================
#
# PATCH /api/patients/:patientId/medical-profile
#
# Updates fields on patient_medical_profiles only.
# At least one field is required.
#
# Request (full example):
# {
#   "allergies": ["Penicillin", "Latex"],
#   "currentMedications": ["Metformin", "Aspirin"],
#   "chronicConditions": ["Diabetes", "Hypertension"],
#   "pregnancyStatus": "Not Applicable",
#   "dentalAnxiety": "mild",
#   "lastDentalVisit": "2025-12-01",
#   "lastXrayDate": "2025-06-15",
#   "primaryPhysicianName": "Dr. Patel",
#   "primaryPhysicianPhone": "9988776655",
#   "initialChiefComplaint": "Sensitivity in upper right molar"
# }
#
# Response (200):
# {
#   "success": true,
#   "message": "Patient medical profile updated successfully",
#   "data": {
#     "patient": {
#       "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
#       "patientCode": "PAT000042",
#       "name": "Rahul Sharma",
#       "phone": "9876543210"
#     },
#     "medicalProfile": {
#       "id": "medical-profile-uuid",
#       "patientId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
#       "allergies": ["Penicillin", "Latex"],
#       "currentMedications": ["Metformin", "Aspirin"],
#       "chronicConditions": ["Diabetes", "Hypertension"],
#       "pregnancyStatus": "Not Applicable",
#       "dentalAnxiety": "mild",
#       "lastDentalVisit": "2025-12-01T00:00:00.000Z",
#       "lastXrayDate": "2025-06-15T00:00:00.000Z",
#       "primaryPhysicianName": "Dr. Patel",
#       "primaryPhysicianPhone": "9988776655",
#       "initialChiefComplaint": "Sensitivity in upper right molar",
#       "createdAt": "2026-01-10T09:00:00.000Z",
#       "updatedAt": "2026-07-07T11:35:00.000Z"
#     },
#     "consents": { ... }
#   }
# }
#
# Error (404):
# { "success": false, "message": "Medical profile not found" }

curl -X PATCH "${PATIENTS}/${PATIENT_ID}/medical-profile" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "allergies": ["Penicillin", "Latex"],
    "currentMedications": ["Metformin", "Aspirin"],
    "chronicConditions": ["Diabetes", "Hypertension"],
    "pregnancyStatus": "Not Applicable",
    "dentalAnxiety": "mild",
    "lastDentalVisit": "2025-12-01",
    "lastXrayDate": "2025-06-15",
    "primaryPhysicianName": "Dr. Patel",
    "primaryPhysicianPhone": "9988776655",
    "initialChiefComplaint": "Sensitivity in upper right molar"
  }'

# Partial update (only allergies and dental anxiety):
curl -X PATCH "${PATIENTS}/${PATIENT_ID}/medical-profile" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "allergies": ["Penicillin"],
    "dentalAnxiety": "moderate"
  }'

# Clear a nullable field (set to null):
curl -X PATCH "${PATIENTS}/${PATIENT_ID}/medical-profile" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "primaryPhysicianName": null,
    "primaryPhysicianPhone": null,
    "initialChiefComplaint": null
  }'


# =============================================================================
# 3 — UPDATE PATIENT (COMBINED — basic + medical in one call)
# =============================================================================
#
# PUT /api/patients/:id
#
# Legacy/combined update. Can include any basic or medical fields together.
#
# Request:
# {
#   "name": "Rahul Sharma",
#   "phone": "9876543210",
#   "allergies": ["Penicillin"],
#   "dentalAnxiety": "mild"
# }
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "patient": { ... },
#     "medicalProfile": { ... },
#     "consents": { ... }
#   }
# }

curl -X PUT "${PATIENTS}/${PATIENT_ID}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "name": "Rahul Sharma",
    "phone": "9876543210",
    "allergies": ["Penicillin"],
    "dentalAnxiety": "mild"
  }'


# =============================================================================
# 4 — GET PATIENT DETAILS (for reference before/after edit)
# =============================================================================
#
# GET /api/patients/:id

curl -X GET "${PATIENTS}/${PATIENT_ID}" \
  -H "${AUTH_HEADER}"
