#!/usr/bin/env bash
# =============================================================================
# Dental Backend — Billing / Invoices API cURLs (flow order)
# =============================================================================
#
# Base URL:     http://localhost:4000/api/invoices
# Patients:     http://localhost:4000/api/patients
# Auth:         All routes require Authorization: Bearer <token>
#
# Setup:
#   export BASE_URL="http://localhost:4000"
#   export TOKEN="<jwt>"
#   export CLINIC_ID="<clinic-uuid>"
#   export PATIENT_ID="<patient-uuid>"
#   export INVOICE_ID="<invoice-uuid>"
#   export CONSULTATION_SERVICE_ID="<service-uuid>"
#   export XRAY_SERVICE_ID="<service-uuid>"
#   export CONSULTATION_ID="<consultation-uuid>"
#
# Flow:
#   Create invoice (backend calculates prices, membership discounts, tax)
#   → Receive payment(s) via POST /api/invoices/:id/payments
#   → Invoice PDF generated server-side and stored in Files module
#
# Invoice status: draft | pending | partially_paid | paid | cancelled | refunded
# Source types: consultation | lab_request | radiograph | dental_lab | membership | manual
#
# Doctors have read-only access to financial endpoints.
#
# =============================================================================

BASE_URL="${BASE_URL:-http://localhost:4000}"
TOKEN="${TOKEN:-YOUR_JWT_TOKEN}"

AUTH_HEADER="Authorization: Bearer ${TOKEN}"
JSON_HEADER="Content-Type: application/json"
INVOICES="${BASE_URL}/api/invoices"
PATIENTS="${BASE_URL}/api/patients"


# =============================================================================
# STEP 0 — LOGIN
# =============================================================================

curl -X POST "${BASE_URL}/api/auth/login" \
  -H "${JSON_HEADER}" \
  -d '{
    "email": "reception@yourvcare.com",
    "password": "YourPassword123"
  }'


# =============================================================================
# STEP 1 — CREATE INVOICE (treatment billing)
# =============================================================================
#
# POST /api/invoices
#
# Frontend submits patient, items with manual unitPrice/quantity, and optional manual discount.
# Each item can either specify a serviceCatalog ID (`serviceId`) or a custom name (`serviceName`).
# Backend applies active membership benefits (if serviceId matches a benefit code), calculates tax, and totals.
#
# Request (Catalog services with frontend manual pricing):
# {
#   "patientId": "<uuid>",
#   "clinicId": "<uuid>",
#   "sourceType": "consultation",
#   "sourceId": "<consultation-uuid>",
#   "manualDiscount": 0,
#   "items": [
#     { "serviceId": "<consultation-service-uuid>", "quantity": 1, "unitPrice": 500, "taxPercentage": 18 },
#     { "serviceId": "<xray-service-uuid>", "quantity": 1, "unitPrice": 300, "taxPercentage": 18 }
#   ]
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "invoice": {
#       "id": "<uuid>",
#       "invoiceNumber": "INV000043",
#       "patientId": "<uuid>",
#       "clinicId": "<uuid>",
#       "sourceType": "consultation",
#       "sourceId": "<uuid>",
#       "subtotal": 800,
#       "membershipDiscount": 500,
#       "manualDiscount": 0,
#       "taxAmount": 54,
#       "grandTotal": 354,
#       "amountPaid": 0,
#       "balanceAmount": 354,
#       "status": "pending",
#       "invoicePdfFileId": "<file-uuid>"
#     },
#     "items": [
#       {
#         "id": "<uuid>",
#         "serviceId": "<uuid>",
#         "serviceName": "General Consultation",
#         "quantity": 1,
#         "unitPrice": 500,
#         "discountAmount": 500,
#         "taxPercentage": 18,
#         "taxAmount": 0,
#         "lineTotal": 0
#       },
#       {
#         "id": "<uuid>",
#         "serviceName": "Dental Radiograph",
#         "quantity": 1,
#         "unitPrice": 300,
#         "discountAmount": 300,
#         "taxPercentage": 18,
#         "taxAmount": 0,
#         "lineTotal": 0
#       }
#     ],
#     "payments": [],
#     "patient": { "id": "<uuid>", "name": "John Doe", "patientCode": "PAT000012" },
#     "clinic": { "id": "<uuid>", "clinicName": "Your VCare Dental" },
#     "invoicePdfFileId": "<file-uuid>"
#   }
# }
#
# Invoice items are immutable snapshots.

curl -X POST "${INVOICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "patientId": "'"${PATIENT_ID}"'",
    "clinicId": "'"${CLINIC_ID}"'",
    "sourceType": "consultation",
    "sourceId": "'"${CONSULTATION_ID}"'",
    "manualDiscount": 0,
    "items": [
      { "serviceId": "'"${CONSULTATION_SERVICE_ID}"'", "quantity": 1, "unitPrice": 500, "taxPercentage": 18 },
      { "serviceId": "'"${XRAY_SERVICE_ID}"'", "quantity": 1, "unitPrice": 300, "taxPercentage": 18 }
    ]
  }'


# Manual invoice / custom line item (no linked catalog service):

curl -X POST "${INVOICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "patientId": "'"${PATIENT_ID}"'",
    "clinicId": "'"${CLINIC_ID}"'",
    "sourceType": "manual",
    "manualDiscount": 200,
    "items": [
      { "serviceName": "Emergency Retainer Repair", "quantity": 1, "unitPrice": 1500, "taxPercentage": 0 }
    ]
  }'


# =============================================================================
# STEP 2 — LIST INVOICES
# =============================================================================
#
# GET /api/invoices?page=1&limit=20&status=pending&patientId=<uuid>&search=INV000
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "items": [ { ...invoice summary with patient/clinic } ],
#     "pagination": { "page": 1, "limit": 20, "total": 12, "totalPages": 1 }
#   }
# }

curl -X GET "${INVOICES}?page=1&limit=20&status=pending" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 3 — GET INVOICE BY ID
# =============================================================================
#
# GET /api/invoices/:id
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "invoice": { ... },
#     "items": [ ... ],
#     "payments": [ ... ],
#     "patient": { ... },
#     "clinic": { ... },
#     "invoicePdfFileId": "<file-uuid>"
#   }
# }
#
# Download PDF via Files/Uploads module using invoicePdfFileId.

curl -X GET "${INVOICES}/${INVOICE_ID}" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 3b — UPDATE PENDING INVOICE
# =============================================================================
#
# PATCH /api/invoices/:id
#
# Allowed only while invoice.status is "pending".
# Recalculates membership discounts, tax, and totals from provided line item prices.
# Invoice number, patient, and clinic stay unchanged. PDF is regenerated.
#
# Request:
# {
#   "manualDiscount": 50,
#   "items": [
#     { "serviceId": "<consultation-service-uuid>", "quantity": 1, "unitPrice": 500 },
#     { "serviceId": "<xray-service-uuid>", "quantity": 2, "unitPrice": 300 }
#   ]
# }
#
# Errors:
#   400 — Only pending invoices can be edited
#   404 — Service not found

curl -X PATCH "${INVOICES}/${INVOICE_ID}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "manualDiscount": 50,
    "items": [
      { "serviceId": "'"${CONSULTATION_SERVICE_ID}"'", "quantity": 1, "unitPrice": 500 },
      { "serviceId": "'"${XRAY_SERVICE_ID}"'", "quantity": 2, "unitPrice": 300 }
    ]
  }'


# =============================================================================
# STEP 4 — RECORD PAYMENT ON INVOICE
# =============================================================================
#
# POST /api/invoices/:id/payments
#
# Request:
# {
#   "amount": 354,
#   "paymentMethod": "cash",
#   "paymentReference": null,
#   "paymentDate": "2026-06-07T12:00:00.000Z",
#   "notes": "Full payment at reception"
# }
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "invoice": {
#       "status": "paid",
#       "amountPaid": 354,
#       "balanceAmount": 0
#     },
#     "payment": {
#       "id": "<uuid>",
#       "invoiceId": "<uuid>",
#       "amount": 354,
#       "paymentMethod": "cash",
#       "paymentDate": "2026-06-07T12:00:00.000Z"
#     }
#   }
# }
#
# Partial payment example (amount < balanceAmount):
#   invoice.status → partially_paid
#   balanceAmount updated automatically
#
# Errors:
#   400 — Invalid payment amount (exceeds balance)
#   400 — Invoice already paid or cancelled

curl -X POST "${INVOICES}/${INVOICE_ID}/payments" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "amount": 354,
    "paymentMethod": "cash",
    "notes": "Full payment at reception"
  }'


# Partial payment example:

curl -X POST "${INVOICES}/${INVOICE_ID}/payments" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "amount": 200,
    "paymentMethod": "upi",
    "paymentReference": "UPI987654321"
  }'


# =============================================================================
# STEP 5 — CANCEL INVOICE
# =============================================================================
#
# PATCH /api/invoices/:id/cancel
#
# Request (optional):
# { "reason": "Duplicate invoice created by mistake" }
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "invoice": { "status": "cancelled", "balanceAmount": 0 },
#     "items": [ ... ],
#     "payments": [ ... ]
#   }
# }
#
# Cannot cancel paid invoices.

curl -X PATCH "${INVOICES}/${INVOICE_ID}/cancel" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "reason": "Duplicate invoice"
  }'


# =============================================================================
# STEP 6 — LIST PATIENT INVOICES
# =============================================================================
#
# GET /api/patients/:patientId/invoices
#
# Response (200):
# { "success": true, "data": [ { ...invoice details } ] }

curl -X GET "${PATIENTS}/${PATIENT_ID}/invoices" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 7 — PATIENT BILLING SUMMARY (via patient details)
# =============================================================================
#
# GET /api/patients/:id
#
# Response includes:
#   membership, membershipHistory, invoices[], outstandingBalance, timeline events

curl -X GET "${PATIENTS}/${PATIENT_ID}" \
  -H "${AUTH_HEADER}"
