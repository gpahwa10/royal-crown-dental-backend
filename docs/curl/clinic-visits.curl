#!/usr/bin/env bash
# =============================================================================
# Dental Backend — Clinic Visits API cURLs (flow order)
# =============================================================================
#
# Base URL:     http://localhost:4000/api/clinic-visits
# Patients:     http://localhost:4000/api/patients
# Auth:         All routes require Authorization: Bearer <token>
#
# Setup:
#   export BASE_URL="http://localhost:4000"
#   export TOKEN="<jwt>"
#   export CLINIC_ID="<clinic-uuid>"
#   export VISIT_ID="<clinic-visit-uuid>"
#   export PATIENT_ID="<patient-uuid>"
#   export DOCTOR_ID="<employee-uuid>"
#   export APPOINTMENT_ID="<appointment-uuid>"
#   export MEMBERSHIP_PLAN_ID="<membership-plan-uuid>"
#   export FILE_ID="<uploaded-file-uuid>"
#
# Clinic visits are physical check-in logs — NOT appointments or consultations.
# Every person who enters the clinic should get a visit record at reception.
#
# Purpose enum: consultation | treatment | follow_up | enquiry | emergency |
#               billing | membership | report_collection | medicine_collection |
#               document_submission | other
#
# Outcome enum: enquiry_only | appointment_booked | patient_registered |
#               consultation_completed | treatment_started | treatment_completed |
#               billing_completed | membership_purchased | reports_collected |
#               cancelled | left_without_consultation | referred | other
#
# Status enum: checked_in | in_progress | completed | cancelled
#
# Authorization:
#   Super Admin — all clinics
#   Reception / Assistant — create and manage visits for their clinic
#   Doctors — read-only, scoped to visits assigned to them
#
# =============================================================================

BASE_URL="${BASE_URL:-http://localhost:4000}"
TOKEN="${TOKEN:-YOUR_JWT_TOKEN}"

AUTH_HEADER="Authorization: Bearer ${TOKEN}"
JSON_HEADER="Content-Type: application/json"
VISITS="${BASE_URL}/api/clinic-visits"
PATIENTS="${BASE_URL}/api/patients"
INVOICES="${BASE_URL}/api/invoices"


# =============================================================================
# STEP 0 — LOGIN
# =============================================================================

curl -X POST "${BASE_URL}/api/auth/login" \
  -H "${JSON_HEADER}" \
  -d '{
    "email": "reception@yourvcare.com",
    "password": "YourPassword123"
  }'


# =============================================================================
# STEP 1 — CREATE CLINIC VISIT (walk-in / enquiry check-in)
# =============================================================================
#
# POST /api/clinic-visits
#
# Request:
# {
#   "clinicId": "<uuid>",
#   "visitorName": "Rahul Sharma",
#   "visitorPhone": "9876543210",
#   "visitorEmail": "rahul@example.com",
#   "purpose": "enquiry",
#   "notes": "Interested in teeth whitening",
#   "doctorId": "<optional-doctor-uuid>",
#   "patientId": "<optional-existing-patient-uuid>",
#   "appointmentId": "<optional-appointment-uuid>",
#   "leadId": "<optional-lead-uuid>"
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "visit": {
#       "id": "<uuid>",
#       "visitNumber": "CV000001",
#       "clinicId": "<uuid>",
#       "patientId": null,
#       "visitorName": "Rahul Sharma",
#       "visitorPhone": "9876543210",
#       "purpose": "enquiry",
#       "status": "checked_in",
#       "isRegistered": false,
#       "checkInTime": "2026-06-07T09:15:00.000Z",
#       "checkOutTime": null
#     },
#     "clinic": { "id": "<uuid>", "clinicName": "Your VCare Dental" },
#     "patient": null,
#     "doctor": null,
#     "appointment": null,
#     "consultation": null,
#     "invoice": null,
#     "membership": null,
#     "medicalRecords": []
#   }
# }

curl -X POST "${VISITS}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"clinicId\": \"${CLINIC_ID}\",
    \"visitorName\": \"Rahul Sharma\",
    \"visitorPhone\": \"9876543210\",
    \"visitorEmail\": \"rahul@example.com\",
    \"purpose\": \"enquiry\",
    \"notes\": \"Interested in teeth whitening\"
  }"


# =============================================================================
# STEP 2 — LIST CLINIC VISITS (search & filters)
# =============================================================================
#
# GET /api/clinic-visits
#
# Query params:
#   page, limit, clinicId, doctorId, patientId, purpose, outcome, status,
#   isRegistered (true|false), treatmentPerformed (true|false),
#   search (visit number / name / phone / email), dateFrom, dateTo
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "visits": [ { "visit": { ... }, "clinic": { ... }, ... } ],
#     "pagination": { "page": 1, "limit": 20, "total": 42, "totalPages": 3 }
#   }
# }

curl -X GET "${VISITS}?page=1&limit=20&clinicId=${CLINIC_ID}&purpose=enquiry&status=checked_in&dateFrom=2026-06-01&dateTo=2026-06-30" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 3 — GET CLINIC VISIT BY ID (includes dynamic timeline)
# =============================================================================
#
# GET /api/clinic-visits/:id
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "visit": { "id": "<uuid>", "visitNumber": "CV000001", ... },
#     "clinic": { ... },
#     "patient": null,
#     "doctor": null,
#     "timeline": [
#       { "type": "visitor_checked_in", "date": "2026-06-07T09:15:00.000Z" }
#     ],
#     "medicalRecords": []
#   }
# }

curl -X GET "${VISITS}/${VISIT_ID}" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 4 — UPDATE CLINIC VISIT
# =============================================================================
#
# PATCH /api/clinic-visits/:id
#
# Allowed fields: purpose, doctorId, outcome, notes, treatmentPerformed
# Cannot edit: visitNumber, patientId, createdBy
#
# Request:
# {
#   "purpose": "consultation",
#   "doctorId": "<doctor-uuid>",
#   "outcome": "enquiry_only",
#   "notes": "Visitor wants second opinion",
#   "treatmentPerformed": null
# }

curl -X PATCH "${VISITS}/${VISIT_ID}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"purpose\": \"consultation\",
    \"doctorId\": \"${DOCTOR_ID}\",
    \"notes\": \"Assigned to Dr. Mehta\"
  }"


# =============================================================================
# STEP 5 — REGISTER PATIENT FROM VISIT
# =============================================================================
#
# POST /api/clinic-visits/:id/register-patient
#
# Converts visitor to patient. Name/phone default from visit if omitted.
#
# Request:
# {
#   "patientType": "new",
#   "gender": "Male",
#   "dateOfBirth": "1990-05-15",
#   "allergies": [],
#   "currentMedications": [],
#   "chronicConditions": [],
#   "treatmentConsentSigned": true,
#   "privacyAccepted": true
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "visit": { "patientId": "<uuid>", "isRegistered": true, "outcome": "patient_registered", ... },
#     "patient": { "patient": { ... }, "medicalProfile": { ... }, "consents": { ... } }
#   }
# }

curl -X POST "${VISITS}/${VISIT_ID}/register-patient" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "patientType": "new",
    "gender": "Male",
    "dateOfBirth": "1990-05-15",
    "allergies": [],
    "currentMedications": [],
    "chronicConditions": [],
    "treatmentConsentSigned": true,
    "privacyAccepted": true
  }'


# =============================================================================
# STEP 6 — CREATE APPOINTMENT FROM VISIT (enquiry → booking)
# =============================================================================
#
# POST /api/clinic-visits/:id/create-appointment
#
# Requires registered patient on visit (or patientId on visit).
#
# Request (option A — ISO datetime):
# {
#   "employeeId": "<doctor-uuid>",
#   "scheduledAt": "2026-06-10T10:30:00.000Z",
#   "symptoms": "Tooth sensitivity"
# }
#
# Request (option B — date + time):
# {
#   "employeeId": "<doctor-uuid>",
#   "appointmentDate": "2026-06-10",
#   "appointmentTime": "10:30",
#   "symptoms": "Tooth sensitivity"
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "visit": { "appointmentId": "<uuid>", "outcome": "appointment_booked", ... },
#     "appointment": { "id": "<uuid>", "status": "scheduled", ... }
#   }
# }

curl -X POST "${VISITS}/${VISIT_ID}/create-appointment" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"employeeId\": \"${DOCTOR_ID}\",
    \"appointmentDate\": \"2026-06-10\",
    \"appointmentTime\": \"10:30\",
    \"symptoms\": \"Tooth sensitivity\"
  }"


# =============================================================================
# STEP 7 — START CONSULTATION FROM VISIT
# =============================================================================
#
# POST /api/clinic-visits/:id/start-consultation
#
# Creates consultation, links consultationId, sets status in_progress.
#
# Request:
# {
#   "doctorId": "<doctor-uuid>",
#   "chiefComplaint": "Pain in lower left molar",
#   "appointmentId": "<optional-appointment-uuid>"
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "visit": { "consultationId": "<uuid>", "status": "in_progress", ... },
#     "consultation": { "id": "<uuid>", "status": "in_progress", ... }
#   }
# }

curl -X POST "${VISITS}/${VISIT_ID}/start-consultation" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"doctorId\": \"${DOCTOR_ID}\",
    \"chiefComplaint\": \"Pain in lower left molar\"
  }"


# =============================================================================
# STEP 8 — CREATE MEMBERSHIP FROM VISIT
# =============================================================================
#
# POST /api/clinic-visits/:id/create-membership
#
# Purchases membership for visit patient. Optional inline payment.
#
# Request:
# {
#   "membershipPlanId": "<uuid>",
#   "payment": {
#     "amount": 4999,
#     "paymentMethod": "upi",
#     "paymentReference": "UPI123456",
#     "notes": "Gold plan annual"
#   }
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "visit": { "membershipId": "<uuid>", "outcome": "membership_purchased", ... },
#     "membership": { ... },
#     "invoice": { ... },
#     "payment": { ... }
#   }
# }

curl -X POST "${VISITS}/${VISIT_ID}/create-membership" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"membershipPlanId\": \"${MEMBERSHIP_PLAN_ID}\",
    \"payment\": {
      \"amount\": 4999,
      \"paymentMethod\": \"upi\",
      \"paymentReference\": \"UPI123456\"
    }
  }"


# =============================================================================
# STEP 9 — ATTACH MEDICAL RECORD (previous reports)
# =============================================================================
#
# POST /api/clinic-visits/:id/attach-medical-record
#
# Links an already-uploaded file (Files/Uploads module) to the visit.
# Use uploads presign → register flow first to obtain fileId.
#
# Request:
# { "fileId": "<uuid>" }
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "visit": { "outcome": "reports_collected", ... },
#     "medicalRecords": [
#       {
#         "id": "<uuid>",
#         "fileId": "<uuid>",
#         "fileName": "previous-xray.pdf",
#         "fileUrl": "https://...",
#         "contentType": "application/pdf"
#       }
#     ]
#   }
# }

curl -X POST "${VISITS}/${VISIT_ID}/attach-medical-record" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"fileId\": \"${FILE_ID}\"
  }"


# =============================================================================
# STEP 10 — BILLING INTEGRATION (link invoice to visit)
# =============================================================================
#
# POST /api/invoices
#
# Pass clinicVisitId when creating an invoice during a billing-purpose visit.
# Backend stores invoiceId on visit and sets outcome billing_completed.
#
# Request:
# {
#   "patientId": "<uuid>",
#   "clinicId": "<uuid>",
#   "clinicVisitId": "<visit-uuid>",
#   "sourceType": "manual",
#   "items": [
#     { "serviceId": "<service-uuid>", "quantity": 1 }
#   ]
# }

curl -X POST "${INVOICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d "{
    \"patientId\": \"${PATIENT_ID}\",
    \"clinicId\": \"${CLINIC_ID}\",
    \"clinicVisitId\": \"${VISIT_ID}\",
    \"sourceType\": \"manual\",
    \"items\": [
      { \"serviceId\": \"<SERVICE_UUID>\", \"quantity\": 1 }
    ]
  }"


# =============================================================================
# STEP 11 — CHECK OUT VISITOR
# =============================================================================
#
# PATCH /api/clinic-visits/:id/check-out
#
# Sets checkOutTime and status completed.
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "visit": {
#       "status": "completed",
#       "checkOutTime": "2026-06-07T11:00:00.000Z"
#     }
#   }
# }

curl -X PATCH "${VISITS}/${VISIT_ID}/check-out" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}"


# =============================================================================
# STEP 12 — DASHBOARD METRICS
# =============================================================================
#
# GET /api/clinic-visits/dashboard/metrics
#
# Query: clinicId, dateFrom, dateTo
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "totalVisitors": 120,
#     "registeredPatients": 85,
#     "walkIns": 40,
#     "enquiries": 25,
#     "treatments": 30,
#     "consultations": 55,
#     "membershipSales": 8,
#     "billingVisits": 22,
#     "emergencyVisits": 3,
#     "averageDailyVisits": 15.5,
#     "doctorWiseVisits": [
#       { "doctorId": "<uuid>", "doctorName": "Dr. Mehta", "total": 45 }
#     ],
#     "clinicWiseVisits": [
#       { "clinicId": "<uuid>", "clinicName": "Your VCare Dental", "total": 120 }
#     ]
#   }
# }

curl -X GET "${VISITS}/dashboard/metrics?clinicId=${CLINIC_ID}&dateFrom=2026-06-01&dateTo=2026-06-30" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 13 — PATIENT CLINIC VISIT HISTORY
# =============================================================================
#
# GET /api/patients/:patientId/clinic-visits
#
# Newest first. Also included in GET /api/patients/:id patient details.
#
# Response (200):
# {
#   "success": true,
#   "data": [
#     {
#       "id": "<uuid>",
#       "visitNumber": "CV000001",
#       "purpose": "consultation",
#       "outcome": "consultation_completed",
#       "status": "completed",
#       "visitDate": "2026-06-07T00:00:00.000Z",
#       "checkInTime": "2026-06-07T09:15:00.000Z",
#       "checkOutTime": "2026-06-07T11:00:00.000Z",
#       "doctor": { "id": "<uuid>", "name": "Dr. Mehta" },
#       "appointment": { "id": "<uuid>", "scheduledAt": "..." },
#       "consultation": { "id": "<uuid>", "status": "completed" },
#       "invoice": { "id": "<uuid>", "invoiceNumber": "INV000042", "status": "paid" },
#       "membership": null,
#       "treatmentPerformed": "Composite filling #36",
#       "notes": null
#     }
#   ]
# }

curl -X GET "${PATIENTS}/${PATIENT_ID}/clinic-visits" \
  -H "${AUTH_HEADER}"


# =============================================================================
# ERROR EXAMPLES
# =============================================================================
#
# 404 Clinic not found / Patient not found / Visit not found
# 400 Duplicate check-in (same phone + clinic + active status + same day)
# 400 Already checked out
# 403 Doctor read-only or clinic access denied
# 409 Patient already registered for this visit
