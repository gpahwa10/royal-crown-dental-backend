#!/usr/bin/env bash
# =============================================================================
# Dental Backend — Dental Lab Orders API cURLs (flow order)
# =============================================================================
#
# Base URL:     http://localhost:4000/api/dental-lab-orders
# Uploads:      http://localhost:4000/api/uploads
# Patients:     http://localhost:4000/api/patients
# Auth:         All routes require Authorization: Bearer <token>
#
# Setup:
#   export BASE_URL="http://localhost:4000"
#   export TOKEN="<jwt>"
#   export CLINIC_ID="<clinic-uuid>"
#   export PATIENT_ID="<patient-uuid>"
#   export DOCTOR_ID="<doctor-uuid>"
#   export CONSULTATION_ID="<consultation-uuid>"   # optional
#   export ORDER_ID="<dental-lab-order-uuid>"
#   export FILE_ID="<registered-upload-uuid>"
#
# Flow:
#   Create order (ordered)
#   → Attach files (via uploads module + POST /files)
#   → PATCH /deliver (delivered)
#   → POST /cementation-appointment OR PATCH /cementation
#
# Status: ordered → delivered → cementation_done
#
# =============================================================================

BASE_URL="${BASE_URL:-http://localhost:4000}"
TOKEN="${TOKEN:-YOUR_JWT_TOKEN}"

AUTH_HEADER="Authorization: Bearer ${TOKEN}"
JSON_HEADER="Content-Type: application/json"
DENTAL_LAB="${BASE_URL}/api/dental-lab-orders"
UPLOADS="${BASE_URL}/api/uploads"
PATIENTS="${BASE_URL}/api/patients"


# =============================================================================
# STEP 0 — LOGIN
# =============================================================================

curl -X POST "${BASE_URL}/api/auth/login" \
  -H "${JSON_HEADER}" \
  -d '{
    "email": "reception@yourvcare.com",
    "password": "YourPassword123"
  }'


# =============================================================================
# STEP 1 — CREATE DENTAL LAB ORDER
# =============================================================================
#
# POST /api/dental-lab-orders
#
# Request:
# {
#   "patientId": "<uuid>",
#   "consultationId": null,
#   "clinicId": "<uuid>",
#   "measuredByDoctorId": "<doctor-uuid>",
#   "labName": "Precision Dental Lab",
#   "itemType": "crown",
#   "toothNumber": "16",
#   "shade": "A2",
#   "description": "Zirconia crown for upper right first molar",
#   "estimatedDeliveryDate": "2026-06-20T00:00:00.000Z",
#   "orderedDate": "2026-06-07T10:00:00.000Z",
#   "notes": "Patient prefers natural shade"
# }
#
# itemType: crown | bridge | veneer | denture | implant_crown | night_guard |
#           orthodontic_retainer | custom_abutment | impression_tray
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "order": {
#       "id": "uuid",
#       "orderCode": "DL000001",
#       "status": "ordered",
#       ...
#     },
#     "patient": { "id", "patientCode", "name" },
#     "clinic": { "id", "clinicName" },
#     "measuredDoctor": { "id", "name" },
#     "cementationDoctor": null,
#     "attachments": [],
#     "appointment": null
#   }
# }

curl -X POST "${DENTAL_LAB}/" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{
    "patientId": "'"${PATIENT_ID}"'",
    "clinicId": "'"${CLINIC_ID}"'",
    "measuredByDoctorId": "'"${DOCTOR_ID}"'",
    "labName": "Precision Dental Lab",
    "itemType": "crown",
    "toothNumber": "16",
    "shade": "A2",
    "description": "Zirconia crown for upper right first molar",
    "estimatedDeliveryDate": "2026-06-20T00:00:00.000Z",
    "notes": "Patient prefers natural shade"
  }'

# From consultation
curl -X POST "${DENTAL_LAB}/" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{
    "patientId": "'"${PATIENT_ID}"'",
    "consultationId": "'"${CONSULTATION_ID}"'",
    "clinicId": "'"${CLINIC_ID}"'",
    "measuredByDoctorId": "'"${DOCTOR_ID}"'",
    "labName": "Elite Prosthetics Lab",
    "itemType": "bridge",
    "toothNumber": "14-16",
    "shade": "B1",
    "description": "3-unit PFM bridge"
  }'


# =============================================================================
# STEP 2 — LIST DENTAL LAB ORDERS
# =============================================================================
#
# GET /api/dental-lab-orders?page=1&limit=20&status=ordered&search=crown
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "items": [ { "id", "orderCode", "status", "attachments", ... } ],
#     "total": 1,
#     "page": 1,
#     "limit": 20
#   }
# }

curl -G "${DENTAL_LAB}/" \
  -H "${AUTH_HEADER}" \
  --data-urlencode "page=1" \
  --data-urlencode "limit=20"

curl -G "${DENTAL_LAB}/" \
  -H "${AUTH_HEADER}" \
  --data-urlencode "status=ordered" \
  --data-urlencode "search=DL000001"


# =============================================================================
# STEP 3 — GET ORDER DETAILS
# =============================================================================
#
# GET /api/dental-lab-orders/:id

curl -X GET "${DENTAL_LAB}/${ORDER_ID}" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 4 — ATTACH FILE (upload first via S3 module)
# =============================================================================
#
# 4a. Presign upload (documentType: patient_document or treatment, etc.)
curl -X POST "${UPLOADS}/presign" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{
    "patientId": "'"${PATIENT_ID}"'",
    "documentType": "patient_document",
    "fileName": "Impression_Scan.stl",
    "contentType": "application/octet-stream"
  }'

# 4b. PUT file to S3 using uploadUrl from presign response
# 4c. Register upload
curl -X POST "${UPLOADS}/${FILE_ID}/register" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{}'

# 4d. Attach to dental lab order
#
# POST /api/dental-lab-orders/:id/files
#
# Request: { "fileId": "<uuid>" }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "order": { ... },
#     "attachments": [ { "id", "originalFileName", "documentType", ... } ],
#     ...
#   }
# }

curl -X POST "${DENTAL_LAB}/${ORDER_ID}/files" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{
    "fileId": "'"${FILE_ID}"'"
  }'


# =============================================================================
# STEP 5 — MARK DELIVERED
# =============================================================================
#
# PATCH /api/dental-lab-orders/:id/deliver
#
# Transitions: ordered → delivered
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "order": { "status": "delivered", "deliveredDate": "..." },
#     ...
#   }
# }
#
# Error (400): { "success": false, "message": "Invalid status transition" }

curl -X PATCH "${DENTAL_LAB}/${ORDER_ID}/deliver" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{}'


# =============================================================================
# STEP 6 — CREATE CEMENTATION APPOINTMENT
# =============================================================================
#
# POST /api/dental-lab-orders/:id/cementation-appointment
#
# Only allowed when status = delivered.
# Creates appointmentType = treatment linked to the order.
#
# Request:
# {
#   "employeeId": "<cementation-doctor-uuid>",
#   "appointmentDate": "2026-06-25",
#   "appointmentTime": "10:30",
#   "symptoms": "Crown cementation visit"
# }
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "order": {
#       "cementationAppointmentId": "<appointment-uuid>",
#       ...
#     },
#     "appointment": { "id", "appointmentType": "treatment", ... }
#   }
# }
#
# Error (409): { "success": false, "message": "Appointment already exists" }

curl -X POST "${DENTAL_LAB}/${ORDER_ID}/cementation-appointment" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{
    "employeeId": "'"${DOCTOR_ID}"'",
    "appointmentDate": "2026-06-25",
    "appointmentTime": "10:30",
    "symptoms": "Crown cementation visit"
  }'


# =============================================================================
# STEP 7 — RECORD CEMENTATION
# =============================================================================
#
# PATCH /api/dental-lab-orders/:id/cementation
#
# Transitions: delivered → cementation_done
#
# Request:
# {
#   "cementationDoctorId": "<doctor-uuid>",
#   "cementationDate": "2026-06-25T11:00:00.000Z",
#   "notes": "Cementation completed without complications"
# }
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "order": {
#       "status": "cementation_done",
#       "cementationDate": "...",
#       "cementationDoctorId": "..."
#     },
#     ...
#   }
# }

curl -X PATCH "${DENTAL_LAB}/${ORDER_ID}/cementation" \
  -H "${JSON_HEADER}" \
  -H "${AUTH_HEADER}" \
  -d '{
    "cementationDoctorId": "'"${DOCTOR_ID}"'",
    "cementationDate": "2026-06-25T11:00:00.000Z",
    "notes": "Cementation completed without complications"
  }'


# =============================================================================
# STEP 8 — REMOVE FILE ATTACHMENT
# =============================================================================
#
# DELETE /api/dental-lab-orders/:id/files/:fileId
#
# Removes junction only — does NOT delete the files record.

curl -X DELETE "${DENTAL_LAB}/${ORDER_ID}/files/${FILE_ID}" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 9 — PATIENT DENTAL LAB ORDERS
# =============================================================================
#
# GET /api/patients/:patientId/dental-lab-orders
#
# Response (200):
# {
#   "success": true,
#   "data": [
#     {
#       "id": "uuid",
#       "orderCode": "DL000001",
#       "status": "cementation_done",
#       "attachments": [],
#       "cementationAppointment": { ... },
#       "measuredDoctor": { "id", "name" },
#       "cementationDoctor": { "id", "name" }
#     }
#   ]
# }

curl -X GET "${PATIENTS}/${PATIENT_ID}/dental-lab-orders" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 10 — PATIENT DETAILS (includes dentalLabOrders + timeline)
# =============================================================================
#
# GET /api/patients/:id
#
# Timeline events:
#   dental_lab_order_created
#   dental_lab_file_attached
#   dental_lab_delivered
#   cementation_appointment_created
#   cementation_completed

curl -X GET "${PATIENTS}/${PATIENT_ID}" \
  -H "${AUTH_HEADER}"


# =============================================================================
# ERROR REFERENCE
# =============================================================================
#
# | Message                              | Status |
# |--------------------------------------|--------|
# | Dental lab order not found           | 404    |
# | Patient not found                    | 404    |
# | Doctor not found                     | 404    |
# | Clinic not found                     | 404    |
# | Consultation not found               | 404    |
# | Appointment not found                | 404    |
# | File not found                       | 404    |
# | Invalid status transition            | 400    |
# | Duplicate attachment                 | 409    |
# | Appointment already exists           | 409    |
# | File does not belong to this patient | 400    |
# | File is not ready for attachment     | 400    |
