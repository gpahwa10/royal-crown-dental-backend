#!/usr/bin/env bash
# =============================================================================
# Dental Backend — Service Catalog API cURLs (flow order)
# =============================================================================
#
# Base URL:     http://localhost:4000/api/services
# Auth:         All routes require Authorization: Bearer <token>
#
# Setup:
#   export BASE_URL="http://localhost:4000"
#   export TOKEN="<jwt>"
#   export CLINIC_ID="<clinic-uuid>"
#   export SERVICE_ID="<service-catalog-uuid>"
#
# Flow:
#   Admin configures billable services before billing / membership benefits.
#
# Money is stored as integer rupees (not paise).
#
# =============================================================================

BASE_URL="${BASE_URL:-http://localhost:4000}"
TOKEN="${TOKEN:-YOUR_JWT_TOKEN}"

AUTH_HEADER="Authorization: Bearer ${TOKEN}"
JSON_HEADER="Content-Type: application/json"
SERVICES="${BASE_URL}/api/services"


# =============================================================================
# STEP 0 — LOGIN
# =============================================================================

curl -X POST "${BASE_URL}/api/auth/login" \
  -H "${JSON_HEADER}" \
  -d '{
    "email": "admin@yourvcare.com",
    "password": "YourPassword123"
  }'


# =============================================================================
# STEP 1 — CREATE SERVICE
# =============================================================================
#
# POST /api/services
#
# Request:
# {
#   "clinicId": "<uuid>",
#   "serviceCode": "CONSULTATION",
#   "serviceName": "General Consultation",
#   "description": "Initial dental consultation",
#   "category": "clinical",
#   "defaultPrice": 500,
#   "taxPercentage": 18,
#   "isTaxable": true
# }
#
# serviceCode is optional — auto-generated if omitted (e.g. SVC000001).
# Clinic employees use their JWT clinicId; super admins must pass clinicId.
#
# Response (201):
# {
#   "success": true,
#   "data": {
#     "id": "<uuid>",
#     "serviceCode": "CONSULTATION",
#     "serviceName": "General Consultation",
#     "description": "Initial dental consultation",
#     "category": "clinical",
#     "defaultPrice": 500,
#     "taxPercentage": 18,
#     "isTaxable": true,
#     "isActive": true,
#     "clinicId": "<uuid>",
#     "createdAt": "2026-06-07T10:00:00.000Z",
#     "updatedAt": "2026-06-07T10:00:00.000Z"
#   }
# }

curl -X POST "${SERVICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "clinicId": "'"${CLINIC_ID}"'",
    "serviceCode": "CONSULTATION",
    "serviceName": "General Consultation",
    "description": "Initial dental consultation",
    "category": "clinical",
    "defaultPrice": 500,
    "taxPercentage": 18,
    "isTaxable": true
  }'


# Additional seed services (run as needed):

curl -X POST "${SERVICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "clinicId": "'"${CLINIC_ID}"'",
    "serviceCode": "RCT",
    "serviceName": "Root Canal Treatment",
    "category": "clinical",
    "defaultPrice": 8000,
    "taxPercentage": 18,
    "isTaxable": true
  }'

curl -X POST "${SERVICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "clinicId": "'"${CLINIC_ID}"'",
    "serviceCode": "XRAY",
    "serviceName": "Dental Radiograph",
    "category": "diagnostic",
    "defaultPrice": 300,
    "taxPercentage": 18,
    "isTaxable": true
  }'

curl -X POST "${SERVICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "clinicId": "'"${CLINIC_ID}"'",
    "serviceCode": "DENTAL_LAB",
    "serviceName": "Dental Lab Prosthetic",
    "category": "lab",
    "defaultPrice": 12000,
    "taxPercentage": 18,
    "isTaxable": true
  }'

curl -X POST "${SERVICES}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "clinicId": "'"${CLINIC_ID}"'",
    "serviceCode": "MEMBERSHIP",
    "serviceName": "Membership Plan",
    "category": "membership",
    "defaultPrice": 0,
    "taxPercentage": 0,
    "isTaxable": false
  }'


# =============================================================================
# STEP 2 — LIST SERVICES
# =============================================================================
#
# GET /api/services?page=1&limit=20&search=consult&category=clinical&isActive=true
#
# Response (200):
# {
#   "success": true,
#   "data": {
#     "items": [ { ...service } ],
#     "pagination": { "page": 1, "limit": 20, "total": 5, "totalPages": 1 }
#   }
# }

curl -X GET "${SERVICES}?page=1&limit=20&isActive=true" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 3 — GET SERVICE BY ID
# =============================================================================
#
# GET /api/services/:id
#
# Response (200):
# { "success": true, "data": { ...service } }

curl -X GET "${SERVICES}/${SERVICE_ID}" \
  -H "${AUTH_HEADER}"


# =============================================================================
# STEP 4 — UPDATE SERVICE
# =============================================================================
#
# PATCH /api/services/:id
#
# Request:
# {
#   "defaultPrice": 600,
#   "taxPercentage": 18,
#   "isActive": true
# }
#
# Response (200):
# { "success": true, "data": { ...updated service } }

curl -X PATCH "${SERVICES}/${SERVICE_ID}" \
  -H "${AUTH_HEADER}" \
  -H "${JSON_HEADER}" \
  -d '{
    "defaultPrice": 600,
    "description": "Updated consultation fee"
  }'


# =============================================================================
# STEP 5 — DEACTIVATE SERVICE (soft delete)
# =============================================================================
#
# DELETE /api/services/:id
#
# Sets isActive = false. Historical invoices retain snapshot prices.
#
# Response (200):
# { "success": true, "data": { ...service with isActive: false } }

curl -X DELETE "${SERVICES}/${SERVICE_ID}" \
  -H "${AUTH_HEADER}"
